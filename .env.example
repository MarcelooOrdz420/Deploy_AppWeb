APP_NAME="Pollos y Parrillas El Dorado"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Opcional: si el frontend corre en otro dominio y consume esta API.
# Ejemplo: API_BASE_URL=http://localhost
API_BASE_URL=

APP_TIMEZONE=America/Lima

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=app_pollos_el_dorado
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=
FCM_SERVICE_ACCOUNT_JSON=

# Opciones: local, ollama, openai.
CHATBOT_PROVIDER=ollama
CHATBOT_ENABLE_OLLAMA=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=60
OLLAMA_TIMEOUT_SECONDS=
OLLAMA_TEMPERATURE=0.4
OLLAMA_NUM_PREDICT=350
OLLAMA_KEEP_ALIVE=10m

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT=25

COMPANY_HOURS="11:00 a. m. a 10:00 p. m."

# CORS (para Flutter Web / frontends en otro puerto/dominio)
# Ejemplo local: CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:56321
# Si lo dejas en "*" permite el Origin que llegue (solo recomendado en local).
CORS_ALLOWED_ORIGINS=*
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

RESEND_API_KEY=
RESEND_FROM_ADDRESS=onboarding@resend.dev
RESEND_FROM_NAME="${APP_NAME}"
RESEND_TIMEOUT=15

GOOGLE_AUTH_CLIENT_IDS=979612097533-vmule768o9q9gfe18trr2ha7kkif8r7h.apps.googleusercontent.com,979612097533-h80d392m1b9789dkd22fldogjqsaitja.apps.googleusercontent.com
GOOGLE_AUTH_WEB_CLIENT_ID=979612097533-vmule768o9q9gfe18trr2ha7kkif8r7h.apps.googleusercontent.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

COMPANY_BRAND_NAME="Pollos y Parrillas El Dorado"
COMPANY_LEGAL_NAME="Pollos y Parrillas El Dorado S.A.C."
COMPANY_RUC=
COMPANY_SUPPORT_PHONE=999888777
COMPANY_SUPPORT_EMAIL=ventas@eldorado.pe
COMPANY_CURRENCY=PEN

COMPANY_IZIPAY_LABEL="Pago seguro con Izipay"
COMPANY_IZIPAY_MESSAGE="Paga con tarjeta desde el checkout seguro de Izipay."

IZIPAY_ENABLED=false
IZIPAY_MODE=test
IZIPAY_API_BASE_URL=https://api.micuentaweb.pe/api-payment/V4
# URL publica que Izipay llamara para confirmar pagos. En produccion usa HTTPS.
# Ejemplo: IZIPAY_IPN_URL=https://pollos.saborcentral.com/izipay-ipn.php
IZIPAY_IPN_URL=
IZIPAY_SHOP_ID=
IZIPAY_REST_API_KEY=
IZIPAY_PUBLIC_KEY=
IZIPAY_HMAC_KEY=
IZIPAY_JS_URL=https://static.micuentaweb.pe/static/js/krypton-client/V4.0/stable/kr-payment-form.min.js
IZIPAY_CSS_URL=https://static.micuentaweb.pe/static/js/krypton-client/V4.0/ext/classic.css

APISPERU_DNIRUC_BASE_URL=https://dniruc.apisperu.com/api/v1
APISPERU_DNIRUC_TOKEN=
APISPERU_DNIRUC_AUTH_MODE=query
APISPERU_DNIRUC_TOKEN_QUERY_PARAM=token
APISPERU_DNIRUC_TIMEOUT=15

# Legacy providers. El checkout consulta DNI/RUC con APISPERU_DNIRUC_*.
RENIEC_LOOKUP_URL=https://dniruc.apisperu.com/api/v1/dni/{numero}
RENIEC_API_TOKEN=
RENIEC_AUTH_MODE=query
RENIEC_TOKEN_QUERY_PARAM=token
RENIEC_TIMEOUT=15

SUNAT_LOOKUP_URL=https://dniruc.apisperu.com/api/v1/ruc/{numero}
SUNAT_API_TOKEN=
SUNAT_AUTH_MODE=query
SUNAT_TOKEN_QUERY_PARAM=token
SUNAT_TOKEN_URL=
SUNAT_GRANT_TYPE=password
SUNAT_CLIENT_ID=
SUNAT_CLIENT_SECRET=
SUNAT_SCOPE=
SUNAT_USERNAME=
SUNAT_PASSWORD=
SUNAT_TIMEOUT=15

EINVOICE_PROVIDER=apisperu
EINVOICE_ENVIRONMENT=beta
EINVOICE_AUTO_SEND=false
EINVOICE_CURRENCY=PEN
EINVOICE_BOLETA_SERIES=B001
EINVOICE_FACTURA_SERIES=F001
COMPANY_FISCAL_ADDRESS=
COMPANY_FISCAL_DEPARTMENT=
COMPANY_FISCAL_PROVINCE=
COMPANY_FISCAL_DISTRICT=
COMPANY_FISCAL_UBIGEO=
COMPANY_FISCAL_COUNTRY_CODE=PE
COMPANY_FISCAL_LOCAL_CODE=0000

APISPERU_FACT_BASE_URL=https://facturacion.apisperu.com/api/v1
APISPERU_FACT_COMPANY_TOKEN=
APISPERU_FACT_USERNAME=
APISPERU_FACT_PASSWORD=
APISPERU_FACT_TIMEOUT=30

# Nubefact: usa EINVOICE_PROVIDER=nubefact para activar este proveedor.
NUBEFACT_ROUTE=
NUBEFACT_TOKEN=
NUBEFACT_TIMEOUT=30
NUBEFACT_SEND_TO_SUNAT=true
NUBEFACT_SEND_TO_CUSTOMER=false
NUBEFACT_PDF_FORMAT=TICKET
NUBEFACT_DEFAULT_SUNAT_PRODUCT_CODE=10000000

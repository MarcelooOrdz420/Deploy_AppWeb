APP_NAME="Pollos y Parrillas El Dorado"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.tudominio.com

# Si tu web y tu API estan en dominios distintos, define aqui la base de la API.
# Ejemplo: API_BASE_URL=https://api.tudominio.com
API_BASE_URL=

APP_TIMEZONE=America/Lima

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pollos_el_dorado
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.tudominio.com

BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

# Opciones: local, ollama, openai.
CHATBOT_PROVIDER=ollama
CHATBOT_ENABLE_OLLAMA=true
# Si Laravel corre en Docker/Coolify y Ollama corre en el host, cambia esta URL
# por el hostname/red interna que pueda alcanzar el contenedor.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=
# Opcional: token Bearer si Ollama esta detras de un proxy protegido.
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=90
OLLAMA_TIMEOUT_SECONDS=
OLLAMA_TEMPERATURE=0.35
OLLAMA_NUM_PREDICT=450
OLLAMA_KEEP_ALIVE=10m

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT=25

COMPANY_HOURS="11:00 a. m. a 10:00 p. m."

# CORS (pon aquí el/los dominios reales de tu web y/o Flutter Web)
# Ejemplo: CORS_ALLOWED_ORIGINS=https://tudominio.com,https://www.tudominio.com
CORS_ALLOWED_ORIGINS=
FILESYSTEM_DISK=public
GOOGLE_CLOUD_PROJECT_ID=project-46bc2872-9e3a-4f1e-8ed
GOOGLE_APPLICATION_CREDENTIALS=
GCS_BUCKET_NAME=almacenamientopollito
GCS_UPLOAD_PREFIX=uploads
GCS_SIGNED_URL_TTL=60
GCS_PUBLIC_URL=https://storage.googleapis.com/almacenamientopollito
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.tuproveedor.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=ventas@tudominio.com
MAIL_FROM_NAME="${APP_NAME}"

RESEND_API_KEY=
RESEND_FROM_ADDRESS=onboarding@resend.dev
RESEND_FROM_NAME="${APP_NAME}"
RESEND_TIMEOUT=15

COMPANY_BRAND_NAME="Pollos y Parrillas El Dorado"
COMPANY_LEGAL_NAME="Pollos y Parrillas El Dorado S.A.C."
COMPANY_RUC=20123456789
COMPANY_SUPPORT_PHONE=999888777
COMPANY_SUPPORT_EMAIL=ventas@tudominio.com
COMPANY_CURRENCY=PEN

COMPANY_IZIPAY_LABEL="Pago seguro con Izipay"
COMPANY_IZIPAY_MESSAGE="Paga con tarjeta desde el checkout seguro de Izipay."

IZIPAY_ENABLED=true
IZIPAY_MODE=production
IZIPAY_API_BASE_URL=https://api.micuentaweb.pe/api-payment/V4
IZIPAY_IPN_URL=https://tudominio.com/izipay-ipn.php
IZIPAY_SHOP_ID=
IZIPAY_REST_API_KEY=
IZIPAY_PUBLIC_KEY=
IZIPAY_HMAC_KEY=
IZIPAY_JS_URL=https://static.micuentaweb.pe/static/js/krypton-client/V4.0/stable/kr-payment-form.min.js
IZIPAY_CSS_URL=https://static.micuentaweb.pe/static/js/krypton-client/V4.0/ext/classic.css

APISPERU_DNIRUC_BASE_URL=https://dniruc.apisperu.com/api/v1
APISPERU_DNIRUC_TOKEN=
APISPERU_DNIRUC_AUTH_MODE=query
APISPERU_DNIRUC_TOKEN_QUERY_PARAM=token
APISPERU_DNIRUC_TIMEOUT=15

# RENIEC: define la URL exacta del proveedor contratado o del servicio con convenio.
# Usa {dni} como placeholder para el documento.
RENIEC_LOOKUP_URL=https://dniruc.apisperu.com/api/v1/dni/{numero}
RENIEC_API_TOKEN=
RENIEC_AUTH_MODE=query
RENIEC_TOKEN_QUERY_PARAM=token
RENIEC_TIMEOUT=15

# SUNAT: si ya tienes token fijo, usa SUNAT_API_TOKEN.
# Si usas OAuth SUNAT, normalmente completa SUNAT_TOKEN_URL, SUNAT_CLIENT_ID,
# SUNAT_CLIENT_SECRET, SUNAT_SCOPE, SUNAT_USERNAME y SUNAT_PASSWORD.
# Usa {ruc} como placeholder para la consulta.
SUNAT_LOOKUP_URL=https://dniruc.apisperu.com/api/v1/ruc/{numero}
SUNAT_API_TOKEN=
SUNAT_AUTH_MODE=query
SUNAT_TOKEN_QUERY_PARAM=token
SUNAT_TOKEN_URL=
SUNAT_GRANT_TYPE=password
SUNAT_CLIENT_ID=
SUNAT_CLIENT_SECRET=
SUNAT_SCOPE=
SUNAT_USERNAME=
SUNAT_PASSWORD=
SUNAT_TIMEOUT=15

EINVOICE_PROVIDER=apisperu
EINVOICE_ENVIRONMENT=produccion
EINVOICE_AUTO_SEND=false
EINVOICE_FAKE_SEND=false
EINVOICE_CURRENCY=PEN
EINVOICE_BOLETA_SERIES=B001
EINVOICE_FACTURA_SERIES=F001
COMPANY_FISCAL_ADDRESS="Av. Principal 123"
COMPANY_FISCAL_DEPARTMENT=LIMA
COMPANY_FISCAL_PROVINCE=LIMA
COMPANY_FISCAL_DISTRICT=LIMA
COMPANY_FISCAL_UBIGEO=150101
COMPANY_FISCAL_COUNTRY_CODE=PE
COMPANY_FISCAL_LOCAL_CODE=0000

APISPERU_FACT_BASE_URL=https://facturacion.apisperu.com/api/v1
APISPERU_FACT_COMPANY_TOKEN=
APISPERU_FACT_USERNAME=
APISPERU_FACT_PASSWORD=
APISPERU_FACT_TIMEOUT=30

# Nubefact: cambia EINVOICE_PROVIDER=nubefact si emitirás con Nubefact.
NUBEFACT_ROUTE=
NUBEFACT_TOKEN=
NUBEFACT_TIMEOUT=30
NUBEFACT_SEND_TO_SUNAT=true
NUBEFACT_SEND_TO_CUSTOMER=false
NUBEFACT_PDF_FORMAT=TICKET
NUBEFACT_DEFAULT_SUNAT_PRODUCT_CODE=10000000
